{# Instructions tab — setup and usage guide #}
<div class="mjl-tab-content">
{# ═══════ Section 1: Mattermost Configuration ═══════ #}
<div class="card border-0 shadow-none p-0 m-0 mt-n2">
    <div class="card-header mb-3 pt-2 border-top rounded-0"
         style="background-color: var(--glpi-form-header-bg); color: var(--glpi-form-header-fg); border-color: var(--glpi-form-header-border-color);">
        <h4 class="card-title ms-5">
            <div class="ribbon ribbon-bookmark ribbon-top ribbon-start bg-blue s-1">
                <i class="fs-2x ti ti-server"></i>
            </div>
            {{ __('Mattermost Configuration', 'mattermostjetlag') }}
        </h4>
    </div>
</div>

<div class="alert alert-info mb-3">
    <i class="ti ti-info-circle flex-shrink-0 me-2" style="font-size: 1.25rem;" aria-hidden="true"></i>
    <div>
        <h5 class="mb-3 mt-0">{{ __('Webhook URL Setup', 'mattermostjetlag') }}</h5>
        <ol class="mb-0">
            <li class="mb-2">{{ __('Go to your Mattermost server and navigate to the channel where you want to receive notifications.', 'mattermostjetlag') }}</li>
            <li class="mb-2">{{ __('Click on the channel name → Integrations → Incoming Webhooks.', 'mattermostjetlag') }}</li>
            <li class="mb-2">{{ __('Click "Add Incoming Webhook" and configure the webhook:', 'mattermostjetlag') }}
                <ul class="mt-2">
                    <li>{{ __('Set a title (e.g., "GLPI Notifications")', 'mattermostjetlag') }}</li>
                    <li>{{ __('Choose the channel where notifications will be posted', 'mattermostjetlag') }}</li>
                    <li>{{ __('Optionally set a default username and icon', 'mattermostjetlag') }}</li>
                </ul>
            </li>
            <li class="mb-2">{{ __('Copy the webhook URL (it looks like: https://your-mattermost.com/hooks/xxxxx)', 'mattermostjetlag') }}</li>
            <li>{{ __('Paste this URL into the "Mattermost Webhook URL" field in the Connection tab of this plugin.', 'mattermostjetlag') }}</li>
        </ol>
    </div>
</div>

<div class="alert alert-warning mb-3">
    <i class="ti ti-alert-triangle flex-shrink-0 me-2" style="font-size: 1.25rem;" aria-hidden="true"></i>
    <div>
        <h5 class="mb-3 mt-0">{{ __('Login / Password Authentication', 'mattermostjetlag') }}</h5>
        <p class="mb-3">{{ __('This method uses Mattermost API with your user credentials. Currently disabled in this plugin version.', 'mattermostjetlag') }}</p>
        <p class="mb-3"><strong>{{ __('Note', 'mattermostjetlag') }}:</strong> {{ __('When using Login / Password authentication, you cannot override the sender nickname and avatar - messages will be sent from the authenticated Mattermost user account.', 'mattermostjetlag') }}</p>
        <ol class="mb-0">
            <li class="mb-2">{{ __('Ensure you have a Mattermost user account with appropriate permissions.', 'mattermostjetlag') }}</li>
            <li class="mb-2">{{ __('The API URL format is: https://your-mattermost.com/api/v4/', 'mattermostjetlag') }}</li>
            <li>{{ __('Enter your Mattermost login credentials in the Connection tab.', 'mattermostjetlag') }}</li>
        </ol>
    </div>
</div>

<div class="alert alert-info mb-3">
    <i class="ti ti-key flex-shrink-0 me-2" style="font-size: 1.25rem;" aria-hidden="true"></i>
    <div>
        <h5 class="mb-3 mt-0">{{ __('Personal Token Authentication', 'mattermostjetlag') }}</h5>
        <p class="mb-3">{{ __('This method uses a personal access token for API authentication. Currently disabled in this plugin version.', 'mattermostjetlag') }}</p>
        <ol class="mb-0">
            <li class="mb-2">{{ __('Log in to your Mattermost account.', 'mattermostjetlag') }}</li>
            <li class="mb-2">{{ __('Go to Account Settings → Security → Personal Access Tokens.', 'mattermostjetlag') }}</li>
            <li class="mb-2">{{ __('Click "Create Token" and give it a description (e.g., "GLPI Plugin").', 'mattermostjetlag') }}</li>
            <li class="mb-2">{{ __('Copy the generated token immediately (it will not be shown again).', 'mattermostjetlag') }}</li>
            <li>{{ __('Use this token in the Connection tab when Personal Token option becomes available.', 'mattermostjetlag') }}</li>
        </ol>
    </div>
</div>

{# ═══════ Section 2: Plugin Configuration ═══════ #}
<div class="card border-0 shadow-none p-0 m-0 mt-3">
    <div class="card-header mb-3 pt-2 border-top rounded-0"
         style="background-color: var(--glpi-form-header-bg); color: var(--glpi-form-header-fg); border-color: var(--glpi-form-header-border-color);">
        <h4 class="card-title ms-5">
            <div class="ribbon ribbon-bookmark ribbon-top ribbon-start bg-blue s-1">
                <i class="fs-2x ti ti-settings"></i>
            </div>
            {{ __('Plugin Configuration', 'mattermostjetlag') }}
        </h4>
    </div>
</div>

<div class="alert alert-success mb-3">
    <i class="ti ti-plug-connected flex-shrink-0 me-2" style="font-size: 1.25rem;" aria-hidden="true"></i>
    <div>
        <h5 class="mb-3 mt-0">{{ __('Connection Setup', 'mattermostjetlag') }}</h5>
        <ol class="mb-0">
            <li class="mb-2">{{ __('Go to the Connection tab.', 'mattermostjetlag') }}</li>
            <li class="mb-2">{{ __('Select "Webhook URL request" as the connection type.', 'mattermostjetlag') }}</li>
            <li class="mb-2">{{ __('Enter your Mattermost Webhook URL in the "Mattermost Webhook URL" field.', 'mattermostjetlag') }}</li>
            <li class="mb-2">{{ __('Optionally set "Sender default nickname" (e.g., "GLPI Bot") and "Sender default avatar" (emoji like :robot_face: or image URL).', 'mattermostjetlag') }}</li>
            <li>{{ __('Click "Save" to store the connection settings.', 'mattermostjetlag') }}</li>
        </ol>
    </div>
</div>

<div class="alert alert-success mb-3">
    <i class="ti ti-message-plus flex-shrink-0 me-2" style="font-size: 1.25rem;" aria-hidden="true"></i>
    <div>
        <h5 class="mb-3 mt-0">{{ __('Creating Notification Rules', 'mattermostjetlag') }}</h5>
        <ol class="mb-0">
            <li class="mb-2">{{ __('Go to the Editor tab.', 'mattermostjetlag') }}</li>
            <li class="mb-2">{{ __('Fill in the required fields:', 'mattermostjetlag') }}
                <ul class="mt-2">
                    <li><strong>{{ __('Rule name', 'mattermostjetlag') }}:</strong> {{ __('A descriptive name for your rule (must differ from the default)', 'mattermostjetlag') }}</li>
                    <li><strong>{{ __('Target', 'mattermostjetlag') }}:</strong> {{ __('The entity type (Ticket or Approve)', 'mattermostjetlag') }}</li>
                    <li><strong>{{ __('Event Type', 'mattermostjetlag') }}:</strong> {{ __('When to trigger (New, Update, or Delete)', 'mattermostjetlag') }}</li>
                    <li><strong>{{ __('Recipient list', 'mattermostjetlag') }}:</strong> {{ __('Comma-separated list of channels/users (e.g., username for direct message, @channel-name for channel, {requester})', 'mattermostjetlag') }}</li>
                    <li><strong>{{ __('Message template', 'mattermostjetlag') }}:</strong> {{ __('The message to send. Use {macros} for dynamic values (type { to see available options)', 'mattermostjetlag') }}</li>
                </ul>
            </li>
            <li class="mb-2">{{ __('Set "Rule status" to Active or Disable.', 'mattermostjetlag') }}</li>
            <li class="mb-2">{{ __('Optionally enable "Override Mattermost Payload" to send custom JSON payload.', 'mattermostjetlag') }}</li>
            <li>{{ __('Click "Save" to create the rule.', 'mattermostjetlag') }}</li>
        </ol>
    </div>
</div>

<div class="alert alert-success mb-3">
    <i class="ti ti-list flex-shrink-0 me-2" style="font-size: 1.25rem;" aria-hidden="true"></i>
    <div>
        <h5 class="mb-3 mt-0">{{ __('Managing Rules', 'mattermostjetlag') }}</h5>
        <ul class="mb-0">
            <li class="mb-2"><strong>{{ __('Rules List', 'mattermostjetlag') }}:</strong> {{ __('View all your notification rules, sort by columns, search, and perform bulk actions (enable/disable/delete).', 'mattermostjetlag') }}</li>
            <li class="mb-2"><strong>{{ __('Editing Rules', 'mattermostjetlag') }}:</strong> {{ __('Click the pencil icon next to any rule to edit it. After saving a rule, you can set an Extended Filter to limit when the rule triggers.', 'mattermostjetlag') }}</li>
            <li class="mb-2"><strong>{{ __('Extended Filter', 'mattermostjetlag') }}:</strong> {{ __('Use the Extended Filter section to add conditions (e.g., only trigger for tickets with specific priority or status).', 'mattermostjetlag') }}</li>
        </ul>
    </div>
</div>

<div class="alert alert-info mb-0">
    <i class="ti ti-code flex-shrink-0 me-2" style="font-size: 1.25rem;" aria-hidden="true"></i>
    <div>
        <h5 class="mb-3 mt-0">{{ __('Message Templates', 'mattermostjetlag') }}</h5>
        <p class="mb-2">{{ __('You can use the following macros in your message templates:', 'mattermostjetlag') }}</p>
        <ul class="mb-3">
            <li><code>{id}</code> — {{ __('Ticket/Item ID', 'mattermostjetlag') }}</li>
            <li><code>{title}</code> — {{ __('Ticket/Item title', 'mattermostjetlag') }}</li>
            <li><code>{status}</code> — {{ __('Current status', 'mattermostjetlag') }}</li>
            <li><code>{priority}</code> — {{ __('Priority level', 'mattermostjetlag') }}</li>
            <li><code>{requester}</code> — {{ __('Requester username', 'mattermostjetlag') }}</li>
            <li><code>{assigned}</code> — {{ __('Assigned user', 'mattermostjetlag') }}</li>
            <li><code>{link}</code> — {{ __('Direct link to the item', 'mattermostjetlag') }}</li>
            <li>{{ __('And more... Type { in the message field to see all available macros for your selected Target.', 'mattermostjetlag') }}</li>
        </ul>
        <p class="mb-0"><strong>{{ __('Tip', 'mattermostjetlag') }}:</strong> {{ __('You can use Markdown formatting in your messages. The autocomplete feature (type {) helps you insert macros correctly.', 'mattermostjetlag') }}</p>
    </div>
</div>
</div>
