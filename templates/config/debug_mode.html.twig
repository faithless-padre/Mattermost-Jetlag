{# Debug Mode tab — events journal #}
<div class="mjl-tab-content">
{# ═══════ Section header ═══════ #}
<div class="card border-0 shadow-none p-0 m-0 mt-n2">
    <div class="card-header mb-3 pt-2 border-top rounded-0"
         style="background-color: var(--glpi-form-header-bg); color: var(--glpi-form-header-fg); border-color: var(--glpi-form-header-border-color);">
        <h4 class="card-title ms-5">
            <div class="ribbon ribbon-bookmark ribbon-top ribbon-start bg-blue s-1">
                <i class="fs-2x ti ti-bug"></i>
            </div>
            {{ __('Debug Mode', 'mattermostjetlag') }}
        </h4>
    </div>
</div>

{# ═══════ Toolbar ═══════ #}
<div class="mjl-rules-toolbar card border mb-3">
    <div class="card-body py-2">
        <div class="d-flex flex-wrap align-items-center gap-3">
            {% if can_update %}
            <button type="button" id="mjl-log-toggle-btn"
                    class="btn btn-sm {{ extended_log ? 'btn-outline-success' : 'btn-outline-secondary' }}"
                    data-extended-log="{{ extended_log ? '1' : '0' }}"
                    data-i18n-enable="{{ __('Enable events log', 'mattermostjetlag')|e('html_attr') }}"
                    data-i18n-disable="{{ __('Disable events log', 'mattermostjetlag')|e('html_attr') }}">
                <i class="ti {{ extended_log ? 'ti-toggle-right' : 'ti-toggle-left' }} me-1"></i>
                {{ extended_log ? __('Disable events log', 'mattermostjetlag') : __('Enable events log', 'mattermostjetlag') }}
            </button>
            <button type="button" id="mjl-simulate-toggle-btn"
                    class="btn btn-sm {{ simulate_send ? 'btn-outline-warning' : 'btn-outline-secondary' }}"
                    data-simulate-send="{{ simulate_send ? '1' : '0' }}"
                    data-i18n-enable="{{ __('Enable Notify Simulation', 'mattermostjetlag')|e('html_attr') }}"
                    data-i18n-disable="{{ __('Disable Notify Simulation', 'mattermostjetlag')|e('html_attr') }}">
                <i class="ti {{ simulate_send ? 'ti-bell' : 'ti-bell-off' }} me-1"></i>
                {{ simulate_send ? __('Disable Notify Simulation', 'mattermostjetlag') : __('Enable Notify Simulation', 'mattermostjetlag') }}
            </button>
            <button type="button" id="mjl-log-clear-btn" class="btn btn-sm btn-outline-danger">
                <i class="ti ti-trash me-1"></i>{{ __('Clear log', 'mattermostjetlag') }}
            </button>
            <div class="vr"></div>
            <button type="button" id="mjl-self-test-btn" class="btn btn-sm btn-outline-info"
                    data-bs-toggle="modal" data-bs-target="#mjl-self-test-modal">
                <i class="ti ti-stethoscope me-1"></i>{{ __('Self-Test', 'mattermostjetlag') }}
            </button>
            <div id="mjl-self-test-progress" class="d-none align-items-center gap-2">
                <div class="mjl-st-bar-wrap">
                    <div id="mjl-st-bar" class="mjl-st-bar" style="width:0%"></div>
                </div>
                <span id="mjl-st-label" class="mjl-st-label"></span>
            </div>
            {% endif %}
            <span id="mjl-live-dot" class="mjl-live-dot" title="{{ __('Live updates every 5s', 'mattermostjetlag') }}"></span>
            <form class="d-flex align-items-center gap-2 ms-auto" id="mjl-log-search-form">
                <input type="text" id="mjl-log-search" class="form-control form-control-sm"
                       style="width: 200px;"
                       placeholder="{{ __('Task #', 'mattermostjetlag') }}">
                <button type="button" id="mjl-log-search-btn" class="btn btn-sm btn-azure">
                    <i class="ti ti-search me-1"></i>{{ __('Search', 'mattermostjetlag') }}
                </button>
                <button type="button" id="mjl-log-search-clear" class="btn btn-sm btn-outline-secondary">
                    <i class="ti ti-x"></i>
                </button>
            </form>
        </div>
    </div>
</div>

<div class="mjl-log-card card border mb-0" style="overflow: hidden;">
    <div id="mjl-log-list"
         class="mjl-tr-list mjl-log-list-root"
         data-logs="{{ log_items_json|e('html_attr') }}"
         data-ajax-url="{{ ajax_url|e('html_attr') }}"
         data-csrf-token="{{ csrf_token() }}"
         data-i18n-no-logs="{{ __('No events recorded yet.', 'mattermostjetlag')|e }}"
         data-i18n-cleared="{{ __('Log cleared.', 'mattermostjetlag')|e }}">
        {# Rendered by JS #}
    </div>
</div>

{# ═══════ Self-Test modal ═══════ #}
<div class="modal fade" id="mjl-self-test-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="ti ti-stethoscope me-2"></i>{{ __('Plugin Self-Test', 'mattermostjetlag') }}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning mb-3">
                    <i class="ti ti-alert-triangle me-2"></i>
                    {{ __('A test ticket will be created and automatically deleted. The process takes ~30 seconds and will generate events in the log.', 'mattermostjetlag') }}
                </div>
                {% if not simulate_send %}
                <div class="alert alert-info mb-0">
                    <i class="ti ti-bell me-2"></i>
                    {{ __('Tip: enable Notify Simulation to prevent real messages from being sent during the test.', 'mattermostjetlag') }}
                </div>
                {% endif %}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    {{ __('Cancel', 'mattermostjetlag') }}
                </button>
                <button type="button" class="btn btn-info" id="mjl-self-test-confirm">
                    <i class="ti ti-player-play me-1"></i>{{ __('Run Diagnostics', 'mattermostjetlag') }}
                </button>
            </div>
        </div>
    </div>
</div>

<script>
if (typeof window.mjlDebugModeInit === 'function') {
    window.mjlDebugModeInit();
}
</script>
</div>
