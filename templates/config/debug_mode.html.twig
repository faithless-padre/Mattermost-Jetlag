{# Debug Mode tab — event log viewer #}
<div class="mjl-tab-content">
{# ═══════ Section header ═══════ #}
<div class="card border-0 shadow-none p-0 m-0 mt-n2">
    <div class="card-header mb-3 pt-2 border-top rounded-0"
         style="background-color: var(--glpi-form-header-bg); color: var(--glpi-form-header-fg); border-color: var(--glpi-form-header-border-color);">
        <h4 class="card-title ms-5">
            <div class="ribbon ribbon-bookmark ribbon-top ribbon-start bg-blue s-1">
                <i class="fs-2x ti ti-bug"></i>
            </div>
            {{ __('Debug Mode', 'mattermostjetlag') }}
        </h4>
    </div>
</div>

{# ═══════ Toolbar ═══════ #}
<div class="mjl-rules-toolbar card border mb-3">
    <div class="card-body py-2">
        <div class="d-flex flex-wrap align-items-center gap-3">
            {% if can_update %}
            <button type="button" id="mjl-log-toggle-btn"
                    class="btn btn-sm {{ extended_log ? 'btn-warning' : 'btn-danger' }}"
                    data-extended-log="{{ extended_log ? '1' : '0' }}"
                    data-i18n-enable="{{ __('Enable events log', 'mattermostjetlag')|e('html_attr') }}"
                    data-i18n-disable="{{ __('Disable events log', 'mattermostjetlag')|e('html_attr') }}">
                <i class="ti {{ extended_log ? 'ti-toggle-right' : 'ti-toggle-left' }} me-1"></i>
                {{ extended_log ? __('Disable events log', 'mattermostjetlag') : __('Enable events log', 'mattermostjetlag') }}
            </button>
            <button type="button" id="mjl-simulate-toggle-btn"
                    class="btn btn-sm {{ simulate_send ? 'btn-warning' : 'btn-danger' }}"
                    data-simulate-send="{{ simulate_send ? '1' : '0' }}"
                    data-i18n-enable="{{ __('Enable Notify Simulation', 'mattermostjetlag')|e('html_attr') }}"
                    data-i18n-disable="{{ __('Disable Notify Simulation', 'mattermostjetlag')|e('html_attr') }}">
                <i class="ti {{ simulate_send ? 'ti-bell' : 'ti-bell-off' }} me-1"></i>
                {{ simulate_send ? __('Disable Notify Simulation', 'mattermostjetlag') : __('Enable Notify Simulation', 'mattermostjetlag') }}
            </button>
            <button type="button" id="mjl-log-clear-btn" class="btn btn-sm btn-outline-danger">
                <i class="ti ti-trash me-1"></i>{{ __('Clear log', 'mattermostjetlag') }}
            </button>
            {% endif %}
            <form class="d-flex align-items-center gap-2 ms-auto" id="mjl-log-search-form">
                <input type="text" id="mjl-log-search" class="form-control form-control-sm"
                       style="width: 200px;"
                       placeholder="{{ __('Ticket #', 'mattermostjetlag') }}">
                <button type="button" id="mjl-log-search-btn" class="btn btn-sm btn-primary">
                    <i class="ti ti-search me-1"></i>{{ __('Search', 'mattermostjetlag') }}
                </button>
                <button type="button" id="mjl-log-search-clear" class="btn btn-sm btn-outline-secondary">
                    <i class="ti ti-x"></i>
                </button>
            </form>
        </div>
    </div>
</div>

<div class="mjl-log-card card border mb-0">
    <div class="card-body">

        <div id="mjl-log-list"
             class="mjl-log-list mjl-log-list-root"
             data-logs="{{ log_items_json|e('html_attr') }}"
             data-ajax-url="{{ ajax_url|e('html_attr') }}"
             data-csrf-token="{{ csrf_token() }}"
             data-i18n-no-logs="{{ __('No events recorded yet.', 'mattermostjetlag')|e }}"
             data-i18n-cleared="{{ __('Log cleared.', 'mattermostjetlag')|e }}"
             data-i18n-ticket="#">
            {# Header row #}
            <div class="mjl-log-header">
                <span>ID</span>
                <span>{{ __('Target', 'mattermostjetlag') }}</span>
                <span>{{ __('Event', 'mattermostjetlag') }}</span>
                <span>{{ __('Status', 'mattermostjetlag') }}</span>
                <span>{{ __('Type', 'mattermostjetlag') }}</span>
                <span>{{ __('Urgency', 'mattermostjetlag') }}</span>
                <span>{{ __('Priority', 'mattermostjetlag') }}</span>
                <span>{{ __('Ticket', 'mattermostjetlag') }} #</span>
                <span>{{ __('Rules', 'mattermostjetlag') }}</span>
                <span>{{ __('Date', 'mattermostjetlag') }}</span>
                <span></span>
            </div>
            {# Rows rendered by JS #}
        </div>

        <div class="mjl-log-footer">
            <div class="mjl-log-footer-center">
                <button id="mjl-log-show-more" type="button" class="btn btn-sm btn-outline-secondary" style="display:none;">
                    {{ __('Show more', 'mattermostjetlag') }}
                </button>
            </div>
            <div class="mjl-log-footer-right">
                <div class="mjl-paginator mjl-log-paginator">
                    <button type="button" class="mjl-page-link" data-page="prev" title="{{ __('Previous', 'mattermostjetlag') }}">
                        <i class="ti ti-chevron-left"></i>
                    </button>
                    {# page number buttons injected by JS #}
                    <button type="button" class="mjl-page-link" data-page="next" title="{{ __('Next', 'mattermostjetlag') }}">
                        <i class="ti ti-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
if (typeof window.mjlDebugModeInit === 'function') {
    window.mjlDebugModeInit();
}
</script>
</div>
